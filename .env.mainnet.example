# Copiez vers .env pour le développement local. Ne mettez JAMAIS de vraies clés dans ce fichier d'exemple.
PORT=3000
NODE_ENV=production
APP_ENV=mainnet
# Clé facultative CoinGecko (plan Demo). Vide = appels publics (limites plus strictes). À définir uniquement dans l'hébergeur.
COINGECKO_API_KEY=
# Contenu exact du fichier fourni par le Developer Portal pour vérifier le domaine (/validation-key.txt)
PI_VALIDATION_KEY=
