# Copiez vers .env pour le développement local. Ne mettez JAMAIS de vraies clés dans ce fichier d'exemple.
PORT=3000
NODE_ENV=development
APP_ENV=testnet
# La valeur du Pi n'est pas encore disponible : 0 = affiche « à venir » (défaut). 1 = conversions de marché.
PI_VALUE_AVAILABLE=0
# Mode sandbox du SDK Pi (test via l'adresse de développement du portail). 0 par défaut.
PI_SANDBOX=0
# Clé facultative CoinGecko (plan Demo). Vide = appels publics (limites plus strictes). À définir uniquement dans l'hébergeur.
COINGECKO_API_KEY=
# Contenu exact du fichier fourni par le Developer Portal pour vérifier le domaine (/validation-key.txt)
PI_VALIDATION_KEY=

# --- Tests exigés par la core team (Testnet uniquement) ---
# 0 = fermé (défaut). 1 = bouton visible. Passer à 0 dès que le test a servi.
TESTNET_PAYOUT=0
TESTNET_RECEIVE=0
# Clé API de CETTE application + clé secrète du portefeuille (S…) : UNIQUEMENT dans les variables Render.
# Ne jamais les écrire ici, ni les coller dans un chat. Supprimer PI_WALLET_SEED après le test d'envoi.
PI_API_KEY=
PI_WALLET_SEED=
